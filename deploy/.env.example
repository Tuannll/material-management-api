# ========================================================
# CD Machine (Machine B) Environment Configuration
# ========================================================

# MSSQL Database Configuration
SA_PASSWORD=YourStrong@Passw0rd!
SQL_PORT=1433
DB_NAME=MaterialDb

# Application Image Configuration
# Can be Docker Hub (e.g., username/material-management-api)
# or GitHub Container Registry (ghcr.io/username/material-management-api)
# or local private registry (e.g. 192.168.1.10:5000/material-management-api)
IMAGE_NAME=your-registry:5000/material-management-api
IMAGE_TAG=latest

# Application Port
PORT=8080

# Webhook Receiver Port (listens for deploy requests from Jenkins)
WEBHOOK_PORT=9000

# ASP.NET Core Environment (Production or Development)
ASPNETCORE_ENVIRONMENT=Production
